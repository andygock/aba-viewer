{
  "name": "aba-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --project tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "check": "biome check .",
