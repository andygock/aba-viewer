    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
